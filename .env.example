# Discord トークン（ペルソナごとに追加）
DISCORD_TOKEN_EXAMPLE=

# Gemini
GEMINI_API_KEY=

# Ollama（Mac Studio ローカル）
OLLAMA_BASE_URL=http://host.docker.internal:11434

# RAG サービス URL（bot_core から見たアドレス）
RAG_SERVICE_URL=http://rag:8002

# Discord履歴RAG
DISCORD_MESSAGE_DB=/app/data/history/discord_messages.db
DISCORD_RAG_UPDATE_HOUR=3
