# Discord トークン（ペルソナごとに追加）
DISCORD_TOKEN_EXAMPLE=

# RAG用メッセージ収集専用 Discord Bot トークン（任意）
DISCORD_RAG_COLLECTOR_TOKEN=

# Gemini
GEMINI_API_KEY=
GEMINI_API_KEY_SECONDARY=   # 任意: メインキーが失敗した場合のフォールバックキー

# Tavily Web Search（任意: Gemini の web_search tool 用）
TAVILY_API_KEY=

# Ollama（Mac Studio ローカル）
OLLAMA_BASE_URL=http://host.docker.internal:11434

# RAG サービス URL（bot_core から見たアドレス）
RAG_SERVICE_URL=http://localhost:8002

# Discord履歴RAG
DISCORD_MESSAGE_DB=data/history/discord_messages.db
DISCORD_RAG_UPDATE_HOUR=3

# RAG再構築時のメモリ制御
RAG_DEVICE=auto
RAG_TORCH_NUM_THREADS=auto
RAG_ENCODE_BATCH_SIZE=auto
RAG_MAX_EMBED_TEXT_CHARS=12000
RAG_INDEX_REBUILD_TIMEOUT_MS=7200000
RAG_INDEX_REBUILD_ATTEMPTS=1
